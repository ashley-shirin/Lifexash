# Copy this file to .env and fill in real values. Never commit .env.
# In production, set these as environment variables on the host instead of using a file.

# Required. Local MySQL:
DATABASE_URL=mysql+pymysql://lifexash_user:change_me@localhost:3306/lifexash?charset=utf8mb4
# Production, TiDB Cloud Starter (host and user prefix from TiDB Cloud's "Connect" dialog, port 4000):
#   mysql+pymysql://<PREFIX>.<USER>:<PASSWORD>@gateway01.<REGION>.prod.aws.tidbcloud.com:4000/lifexash?charset=utf8mb4
# URL-encode special characters in the password (@ : / ? # %). No SSL options needed in the URL:
# any host other than localhost automatically gets verified TLS (see app/core/database.py).

# Required, at least 32 characters, or the app refuses to start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional (default 60): how long a login token stays valid.
JWT_EXPIRE_MINUTES=60

# Optional (default http://localhost:5173): frontend URLs allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173
