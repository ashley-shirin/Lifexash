# Copy to .env. Vite only exposes variables that start with VITE_.
# This value is baked into the JS bundle at build time, so it's public: never put a secret here.
# Production: set VITE_API_URL in the host's build settings (e.g. https://api.example.com/api).
# `npm run build` stops with an error if it's missing.
VITE_API_URL=http://localhost:8000/api
